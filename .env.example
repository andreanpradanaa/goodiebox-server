# Server
PORT=8080
# Frontend origins yang diizinkan CORS (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:5173

# Database (docker-compose memetakan Postgres ke port 5433)
DATABASE_URL=postgres://goodiebox:goodiebox@localhost:5433/goodiebox?sslmode=disable

# Midtrans (https://dashboard.sandbox.midtrans.com/settings/config_info)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
# true hanya untuk produksi
MIDTRANS_IS_PRODUCTION=false

# Harga satu GoodieBox (IDR, ditentukan server - tidak pernah percaya amount dari client)
BOX_PRICE_IDR=49000
